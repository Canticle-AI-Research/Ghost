# Copy to .env.local only if these values are not already exported.
OPENAI_API_KEY=
GHOST_MODEL=openai:gpt-5.6-terra
# Opaque SEAM service. Use HTTPS and a bearer token outside trusted loopback.
SEAM_BASE_URL=http://127.0.0.1:8765
SEAM_API_TOKEN=
GHOST_SEAM_TIMEOUT=30
# Legacy compatibility path: semantic memory is service-owned. New installs
# should set GHOST_CHECKPOINT_DB directly.
GHOST_SEAM_DB=~/.local/share/ghost/seam.db
# LangGraph conversation checkpoints: execution state only, never semantic
# truth. Defaults beside the SEAM store; keep it a separate file.
GHOST_CHECKPOINT_DB=~/.local/share/ghost/checkpoints.db
GHOST_SEAM_NAMESPACE=ghost.default
GHOST_SEAM_SCOPE=thread
GHOST_RECALL_BUDGET=8
GHOST_GRAPH_HOPS=2
GHOST_MAX_STEPS=25
# Directories the read_file / search_repo tools may read, colon-separated like
# PATH. Empty by default: with no roots, Ghost has no filesystem tools at all.
GHOST_TOOL_ROOTS=

# --- Shell access. Ghost can change the machine when this is on. ---
# Off unless set. With it on, Ghost gets `run_command` and runs with your
# account's full authority.
GHOST_ENABLE_SHELL=
# Ask before every command. On by default whenever the shell is on. Set to 0
# only for deliberate unattended runs.
GHOST_SHELL_APPROVAL=1
GHOST_SHELL_TIMEOUT=120
# Where commands run. Defaults to the current directory.
GHOST_SHELL_WORKDIR=
