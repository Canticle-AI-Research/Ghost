# Copy to .env.local only if these values are not already exported.
OPENAI_API_KEY=
GHOST_MODEL=openai:gpt-5.6-terra
GHOST_SEAM_DB=~/.local/share/ghost/seam.db
GHOST_SEAM_NAMESPACE=ghost.default
GHOST_SEAM_SCOPE=thread
GHOST_RECALL_BUDGET=8
GHOST_GRAPH_HOPS=2
# Directories the read_file / search_repo tools may read, colon-separated like
# PATH. Empty by default: with no roots, Ghost has no filesystem tools at all.
GHOST_TOOL_ROOTS=
